# ICP Portal — environment variable template.
#
# Copy to .env.local and fill in real values:
#     cp .env.example .env.local
#
# .env* is gitignored — NEVER commit a file with real values in it.
# Every key below was derived by grepping every process.env read in the source
# tree, so this list is exhaustive as of Phase 5.

# ---------------------------------------------------------------------------
# REQUIRED — the app will not start or will fail closed without these
# ---------------------------------------------------------------------------

# Turso (libSQL) database. Read by db/index.ts and lib/rate-limit/store.ts.
# db/index.ts throws at import time if this is unset, so a missing value is a
# loud startup failure rather than a silent one.
TURSO_DATABASE_URL=

# Auth token for the Turso database. Optional for a local file: URL, required
# for a hosted libsql:// URL. SECRET — never prefix with NEXT_PUBLIC_.
TURSO_AUTH_TOKEN=

# Session cookie signing key (HMAC-SHA256). SECRET.
# Generate with:  openssl rand -hex 32
# lib/auth/session.ts REFUSES to run if this is unset, shorter than 32
# characters, a known placeholder, or a single repeated character.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — safe defaults exist
# ---------------------------------------------------------------------------

# Support address shown to students. PUBLIC by design: the NEXT_PUBLIC_ prefix
# ships it to the browser, which is correct for a contact address and must
# never be used for anything secret.
# Falls back to icpsupport@gmail.com in db/seed.ts if unset.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# CLI-ONLY — read by db/create-admin.ts, not by the running app
# ---------------------------------------------------------------------------
# Alternatives to passing --email / --password / --name on the command line.
# Leave blank unless you are scripting admin provisioning; a password in a file
# is worse than one typed into a shell you control.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---------------------------------------------------------------------------
# REMOVED / UNUSED — see the Phase 5 report
# ---------------------------------------------------------------------------
# The following keys are present in some existing .env.local files but are read
# by NO code in this repository. They are listed here only so nobody re-adds
# them by accident. Recommended action: delete them from .env.local and from
# the Vercel project, then revoke the credentials at the provider.
#
#   CLOUDINARY_CLOUD_NAME              — Circulars feature was removed
#   CLOUDINARY_API_KEY                 — Circulars feature was removed  (SECRET)
#   CLOUDINARY_API_SECRET              — Circulars feature was removed  (SECRET)
#   NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME  — Circulars feature was removed
#   CRON_SECRET                        — no cron route or scheduled job exists
